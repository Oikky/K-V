# Copie este arquivo pra bot/.env e preencha. O .env nunca vai pro git (o repositório é público).

# Token do bot: no Telegram, fale com o @BotFather, mande /newbot e copie o token.
TELEGRAM_TOKEN=

# Chave da API da Anthropic (a mesma que a D'luh usa).
ANTHROPIC_API_KEY=

# Quem pode usar o bot: números de chat separados por vírgula.
# Mande /start pro bot que ele responde com o seu número.
KV_CHATS=

# Opcionais
# KV_MODELO=claude-sonnet-5
# KV_WHISPER=large-v3
# KV_RASCUNHOS_URL=http://127.0.0.1:8790
