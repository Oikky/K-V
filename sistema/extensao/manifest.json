{
  "manifest_version": 3,
  "name": "K&V Pesquisa",
  "short_name": "K&V",
  "version": "1.2.2",
  "description": "Barra lateral da pesquisa de voos da K&V: cronômetro, busca já preenchida nos sites e lançamento da opção de voo.",
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "action": {
    "default_title": "Abrir a barra da K&V",
    "default_icon": {
      "16": "icone-16.png",
      "48": "icone-48.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://kv-sistema.ikkysousa5.workers.dev/*"
  ],
  "commands": {
    "abrir-barra": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Abrir a barra da K&V"
    }
  }
}
