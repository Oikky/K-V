{
  "manifest_version": 3,
  "name": "K&V Pesquisa",
  "short_name": "K&V",
  "version": "1.0.0",
  "description": "Barra lateral da pesquisa de voos da K&V: abre a busca já preenchida e lança o voo achado no orçamento.",
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" },
  "action": { "default_title": "Abrir a barra da K&V", "default_icon": { "16": "icone-16.png", "48": "icone-48.png" } },
  "side_panel": { "default_path": "painel.html" },
  "background": { "service_worker": "fundo.js" },
  "permissions": ["sidePanel", "scripting", "tabs"],
  "host_permissions": ["https://*/*"]
}
