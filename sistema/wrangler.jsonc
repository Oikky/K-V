// Worker único do sistema K&V: telas (public/), API (/api/*) e bot (/telegram).
// Códigos e senhas ficam em sistema/.env (fora do git; modelo em .env.exemplo) e sobem com:
//   node node_modules/wrangler/bin/wrangler.js secret bulk .env
// No PC, o wrangler dev usa o .dev.vars (só o DEV_EMAIL).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kv-sistema",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kv", "database_id": "62874e00-330a-4561-ac11-d5db25ecdd36", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
