// Worker único do sistema K&V: telas (public/), API (/api/*) e bot (/telegram).
// Segredos (nunca no repositório): wrangler secret put TELEGRAM_TOKEN | TELEGRAM_SECRET | ANTHROPIC_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kv-sistema",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kv", "database_id": "30d950da-9f21-4d6b-97f7-76a39dcfdbed", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    // time do Cloudflare Access (ex.: kv-viagens.cloudflareaccess.com) e o AUD da aplicação
    "ACCESS_TEAM": "kv-viagens.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
