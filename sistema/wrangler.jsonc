// Worker do sistema K&V: telas (public/) e API (/api/*), atrás do login do Access.
// Códigos e senhas ficam em sistema/.env (fora do git; modelo em .env.exemplo) e sobem com:
//   node scripts/segredos.mjs sistema   (o bot tem o próprio Worker: wrangler.bot.jsonc)
// No PC, o wrangler dev usa o .dev.vars (só o DEV_EMAIL).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kv-sistema",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kv", "database_id": "62874e00-330a-4561-ac11-d5db25ecdd36", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
